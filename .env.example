# Copy to .env and fill in. Restart after changes:  docker compose up -d
#
# Put passwords and PINs in 'single quotes'. Otherwise Docker Compose changes a value
# that contains $ and cuts it off at " #".

# Port on the Docker host that serves the site.
HOST_PORT=8080

# Public address of the site, used for the "Open Calendar" button in emails and the
# setup message. Must end with /.
BASE_URL=https://calendar.example.org/

# Timezone for "today", the digest's "yesterday", and email times.
APP_TIMEZONE=America/Chicago

# IP address(es) of your reverse proxy, comma-separated. Requests from these are trusted
# to report the real visitor IP via X-Forwarded-For (shown in the activity log and used
# for wrong-PIN lockouts). Leave empty if visitors connect directly.
TRUSTED_PROXIES=

# --- Who can use the calendar ---
# Family PINs, comma-separated. Any of them unlocks the calendar.
APP_PINS='1234,5678'

# Username and password that phones use to subscribe to /ical.php.
# Leave ICAL_PASS empty to turn the feed off.
ICAL_USER=family
ICAL_PASS=''

# PIN for the web backup page (/backup.php), separate from the family PINs.
# Leave empty to turn web backups off (the command-line export still works).
EXPORT_PIN=''

# --- Email (the daily digest) ---
SMTP_HOST=smtp.example.org
# 587 with STARTTLS, or 465 with SSL.
SMTP_PORT=587
# starttls, ssl, or none. Leave empty to choose from the port (465 = ssl, else starttls).
SMTP_SECURITY=
SMTP_USER=noreply@example.org
SMTP_PASS=''
# The From address. Leave empty to use SMTP_USER.
MAIL_FROM=
MAIL_FROM_NAME=Cottage Booking System

# Digest recipients, comma-separated (sent as BCC). Leave empty for no digest.
DIGEST_RECIPIENTS=
# When to send it each day (24-hour time, APP_TIMEZONE). It covers yesterday's changes and
# arrivals in the next 7 days, and isn't sent on days with nothing to report.
DIGEST_TIME=07:00
